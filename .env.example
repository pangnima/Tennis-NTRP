# ─────────────────────────────────────────────────────────────────────────────
# 이 파일은 "어떤 값이 필요한지"를 보여주는 예시입니다. 값은 비어 있습니다.
#   1) 이 파일을 복사해 .env.local 을 만든다   (cp .env.example .env.local)
#   2) 아래 안내대로 값을 채운다
#   .env.local 은 git에 올라가지 않습니다(.gitignore). 비밀값은 여기가 아니라 .env.local에만 둡니다.
#
# 로컬(.env.local)은 언제나 **테스트 서버(dev, Tennis-NTRP-dev)** 값입니다.
# 실서비스(prod, Tennis-NTRP-prod) 값은 Vercel 대시보드의 Production 환경변수에만 넣습니다 —
# 로컬에서 실서비스 DB에 붙는 길을 만들지 않기 위해서입니다.
#
# 이름이 NEXT_PUBLIC_ 로 시작하는 값은 브라우저(사용자 PC)까지 그대로 전달됩니다 → 공개해도 되는 값만.
# ─────────────────────────────────────────────────────────────────────────────

# [필수] Supabase 프로젝트 주소
#   무엇: 앱이 붙을 DB·로그인 서버의 주소
#   어디서: Supabase 대시보드 → 프로젝트(Tennis-NTRP-dev) → Project Settings → API → Project URL
#   공개 여부: 공개 (브라우저에 노출됨)
NEXT_PUBLIC_SUPABASE_URL=

# [필수] Supabase 공개 키(publishable) — 변수 이름은 ANON_KEY 그대로 쓴다
#   무엇: 브라우저가 쓰는 공개 키. 실제 접근 제어는 DB의 RLS 정책이 한다
#   어디서: Project Settings → API Keys → "Publishable and secret API keys" 탭의 Publishable key (sb_publishable_… 로 시작)
#           옛 "Legacy API Keys" 탭의 anon 키(eyJ… 로 시작)도 동작한다
#           ⚠ [Connect] 화면이 이름을 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY로 보여 줘도 값만 가져오고 이름은 아래 그대로
#   공개 여부: 공개 (브라우저에 노출됨 — 공개 값이라 NEXT_PUBLIC_ 이 맞다. 지우면 사이트 전체가 500이 된다(11-27 사고).
#              "service_role"·"secret" 키와 헷갈리지 말 것, 그건 절대 여기 넣지 않는다)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [필수] service_role 키 — 경기를 기록·수정·삭제한 뒤 **참가 회원 전원**의 레이팅 캐시(users.personal_ntrp)를 다시 계산한다
#   (src/lib/supabase/admin.ts → src/lib/games/recompute.ts, 서버 전용). 0103부터 이 칸은 회원이 스스로 고칠 수 없게
#   DB가 잠가서, **이 값이 없으면 레이팅 캐시가 전혀 갱신되지 않는다**(랭킹·티어가 낡는다).
#   scripts/backfill-personal-ntrp.ts(일괄 보정)도 이 값을 읽는다
#   어디서: Supabase 대시보드 → Project Settings → API Keys → Legacy API Keys 탭 → service_role [Reveal]
#           (같은 화면의 Secret key sb_secret_… 도 된다 — Legacy 키가 폐지되면 이쪽으로 바꾼다)
#           (로컬은 dev 프로젝트의 것. prod 것은 Vercel Production 환경변수에만, Preview·Development에는 dev 것)
#   공개 여부: **비밀** (모든 데이터 읽기·쓰기 가능). NEXT_PUBLIC_ 을 붙이지 않는다 — 브라우저로 나가면 안 된다
SUPABASE_SERVICE_ROLE_KEY=
# [선택] 배포 도메인
#   무엇: 링크 미리보기(OG 이미지)·SEO 메타에 쓰는 절대 주소. 로그인 리다이렉트는 요청 주소를 우선 쓴다
#   어디서: 배포 주소 그대로 (https://baselineplay.vercel.app). 로컬은 비워도 됨
#   공개 여부: 공개
NEXT_PUBLIC_SITE_URL=

# [선택·배포 전용] Vercel Cron 인증 비밀값 — src/app/api/keepalive/route.ts
#   무엇: 매일 한 번 prod DB를 건드려 Supabase 무료 플랜의 7일 무활동 일시정지를 막는 크론의 열쇠.
#         값이 있으면 Vercel이 Authorization 헤더에 실어 보내고 라우트가 대조한다. 없으면 열린 채로 돈다(읽기 1회뿐)
#   어디서: 아무 긴 무작위 문자열 (예: openssl rand -hex 32). Vercel → Settings → Environment Variables → Production에만
#   공개 여부: 비밀. 로컬은 비워 둔다(크론은 배포에서만 돈다)
# CRON_SECRET=

# ───── 아래는 앱이 아니라 scripts/ 의 도구 스크립트만 읽는 값 — 평소 개발에는 필요 없음 ─────

# [선택] 테스트 서버 DB 직접 연결 문자열 — scripts/db-history.ts (마이그레이션 히스토리 내려받기·비교)
#   어디서: Supabase 대시보드 → 상단 [Connect] → Direct connection URI 를 복사해 [YOUR-PASSWORD] 자리를 채운다
#           (DB 비밀번호는 GitHub 비밀번호가 아니다. 모르면 Project Settings → Database → Reset database password)
#   공개 여부: 비밀 (DB 전체 권한). 채팅·이슈에 붙이지 말 것
# DATABASE_URL=

# [선택] 실서비스 DB 직접 연결 문자열 — 새 환경 재생·스키마 비교에만 쓴다. 평소에는 비워 둔다
#   공개 여부: 비밀
# SUPABASE_PROD_DB_URL=

# [선택] 위 두 연결이 실패할 때만 — 스크립트가 Direct URI를 pooler 주소로 바꿔 붙는데,
#   pooler 클러스터 번호가 프로젝트마다 다르다(dev aws-1 · prod aws-0). 기본값이 안 맞으면 지정
# SUPABASE_POOLER_HOST=aws-0-ap-northeast-2.pooler.supabase.com
# SUPABASE_REGION=ap-northeast-2

